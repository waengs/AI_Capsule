# Server
PORT=3000
NODE_ENV=development

# Public origin of the Express app (OAuth callback base).
# Local (API only): http://localhost:3000
# Production (same URL for frontend + API): https://your-app.onrender.com
APP_URL=http://localhost:3000

# Optional: where to send the browser after OAuth (Vite local frontend).
# Leave unset in production so APP_URL is used.
CLIENT_URL=http://localhost:5173

# Application JWT (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
# Homepage URL: your APP_URL
# Authorization callback URL: {APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: path for SQLite file (default: ./data/capsules.db)
# DATABASE_PATH=./data/capsules.db
